{
  "name": "whider-desktop",
  "productName": "WHIDER",
  "version": "1.1.0-beta.1",
  "description": "WHIDER para ordenador: tareas, calendario, avisos y enfoque.",
  "main": "main.js",
  "author": "McTn4",
  "license": "UNLICENSED",
  "repository": "github:McTn4/whider-2.0-PREMIUM",
  "desktopName": "whider.desktop",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-web.js",
    "start": "node scripts/sync-web.js && electron .",
    "dist": "node scripts/sync-web.js && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.1"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "build": {
    "appId": "com.whider.desktop",
    "productName": "WHIDER",
    "copyright": "WHIDER",
    "publish": [
      {
        "provider": "github",
        "owner": "McTn4",
        "repo": "whider-2.0-PREMIUM",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "es",
      "es-419",
      "en",
      "en-US"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "assets/**",
      "www/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-win.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WHIDER",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "WHIDER-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSCameraUsageDescription": "WHIDER usa la cámara para escanear códigos QR de invitación."
      }
    },
    "dmg": {
      "artifactName": "WHIDER-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "artifactName": "WHIDER-linux.${ext}",
      "executableName": "whider",
      "syncDesktopName": true,
      "maintainer": "McTn4 <190192099+McTn4@users.noreply.github.com>",
      "synopsis": "Tareas, calendario, Cuaderno, hábitos y enfoque"
    },
    "deb": {
      "artifactName": "WHIDER-linux.${ext}"
    },
    "protocols": [
      {
        "name": "WHIDER",
        "schemes": [
          "whider"
        ]
      }
    ]
  }
}
