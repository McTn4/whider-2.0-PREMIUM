rules_version = '2';

// WHIDER · Reglas de seguridad de Cloud Firestore (8.0)
//  - users/{uid}/...      Tus datos (tareas, Cuaderno y sus archivos adjuntos, hábitos…): solo tú.
//  - profiles/{uid}       Perfil público (nombre, personaje, racha…): lo leen las cuentas verificadas; solo lo escribe su dueño.
//                         (level, title y xp siguen permitidos solo para que las versiones anteriores no fallen al guardar.)
//  - codes/{código}       Código de amigo → cuenta. Cada uno solo crea o borra el suyo.
//  - inbox/{uid}          Buzón: solicitudes, aceptaciones, ánimos, equipos, avisos de chat e invitaciones por enlace.
//                         El dueño lo lee y lo vacía; los demás solo pueden escribir SU propia entrada (la clave es su uid).
//  - spaces/{id}          Equipos: solo sus miembros. Los miembros solo los cambia el creador (cada uno puede salir),
//                         y quien tenga el enlace del equipo puede añadirse a sí mismo con la clave correcta.
//  - spaces/{id}/pages    Páginas del Cuaderno del equipo: solo sus miembros.
//  - spaces/{id}/files    Archivos adjuntos de esas páginas (ficha y trozos de menos de 1 MB): solo sus miembros.
//  - chats/{id}           Chats de dos y de equipo: solo sus miembros.
//  - chats/{id}/msgs      Mensajes: los escriben los miembros; cada uno edita o borra los suyos y solo su reacción.
// Todo exige un correo verificado (las cuentas de Google ya vienen verificadas).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function team(sid) { return get(/databases/$(database)/documents/spaces/$(sid)).data; }
    function isMember(sid) { return signedIn() && request.auth.uid in team(sid).members; }

    match /users/{uid}/{document=**} {
      allow read, write: if isMe(uid);
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'code', 'buddy', 'avatar', 'photo', 'level', 'title', 'xp', 'streak', 'bestStreak', 'weekDone', 'weekFocus', 'week', 'status', 'updatedAt'])
        && request.resource.data.uid == uid
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() < 100000));
      allow delete: if isMe(uid);
    }

    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid', 'at']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Solo cambia la entrada de quien escribe en cada apartado del buzón
    function onlyMine(after, before) {
      return after.keys().hasOnly(['requests', 'accepted', 'cheers', 'spaces', 'pings', 'links'])
        && after.get('requests', {}).diff(before.get('requests', {})).affectedKeys().hasOnly([request.auth.uid])
        && after.get('accepted', {}).diff(before.get('accepted', {})).affectedKeys().hasOnly([request.auth.uid])
        && after.get('cheers', {}).diff(before.get('cheers', {})).affectedKeys().hasOnly([request.auth.uid])
        && after.get('spaces', {}).diff(before.get('spaces', {})).affectedKeys().hasOnly([request.auth.uid])
        && after.get('pings', {}).diff(before.get('pings', {})).affectedKeys().hasOnly([request.auth.uid])
        && after.get('links', {}).diff(before.get('links', {})).affectedKeys().hasOnly([request.auth.uid]);
    }
    match /inbox/{uid} {
      allow read, write: if isMe(uid);
      allow create: if signedIn() && request.auth.uid != uid && onlyMine(request.resource.data, {});
      allow update: if signedIn() && request.auth.uid != uid && onlyMine(request.resource.data, resource.data);
    }

    match /spaces/{sid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid && request.auth.uid in request.resource.data.members;
      // Miembros: tareas, páginas… El creador cambia los miembros y la clave del enlace; los demás solo pueden salir.
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.owner == resource.data.owner
        && (request.auth.uid == resource.data.owner
            || (request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
                && request.resource.data.get('joinKey', '') == resource.data.get('joinKey', '')));
      // Entrar con el enlace del equipo: solo te añades a ti, con la clave que lleva el enlace
      allow update: if signedIn() && !(request.auth.uid in resource.data.members)
        && resource.data.get('joinKey', '') != ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joins'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get('joins', {}).diff(resource.data.get('joins', {})).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.joins[request.auth.uid] == resource.data.joinKey;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /pages/{pid} {
        allow read, write: if isMember(sid);
      }
      // Archivos adjuntos de las páginas del equipo: la ficha y sus trozos
      match /files/{rest=**} {
        allow read, write: if isMember(sid);
      }
    }

    match /chats/{cid} {
      function isDm(d) {
        return d.type == 'dm' && d.memberIds.size() == 2 && d.memberIds[0] < d.memberIds[1]
          && cid == 'dm_' + d.memberIds[0] + '_' + d.memberIds[1];
      }
      function isTeamChat(d) {
        return d.type == 'team' && cid == 'tm_' + d.sid && d.memberIds.toSet() == team(d.sid).members.keys().toSet();
      }
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds
        && (isDm(request.resource.data) || isTeamChat(request.resource.data));
      allow update: if signedIn() && request.auth.uid in resource.data.memberIds
        && request.resource.data.type == resource.data.type
        && (request.resource.data.memberIds == resource.data.memberIds
            || (resource.data.type == 'team' && request.resource.data.sid == resource.data.sid && isTeamChat(request.resource.data)));

      match /msgs/{mid} {
        function chat() { return get(/databases/$(database)/documents/chats/$(cid)).data; }
        allow read: if signedIn() && request.auth.uid in chat().memberIds;
        allow create: if signedIn() && request.auth.uid in chat().memberIds
          && request.resource.data.by == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 4000;
        // El autor edita o borra lo suyo; cualquiera de los miembros solo cambia su reacción
        allow update: if signedIn() && request.auth.uid in chat().memberIds
          && request.resource.data.by == resource.data.by
          && ((request.auth.uid == resource.data.by && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'del', 'ref', 'react']))
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['react']))
          && request.resource.data.get('react', {}).diff(resource.data.get('react', {})).affectedKeys().hasOnly([request.auth.uid]);
      }
    }

    // Todo lo demás está cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
