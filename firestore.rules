rules_version = '2';

// WHIDER · Reglas de seguridad de Cloud Firestore (1.1)
//  - users/{uid}/...      Tus datos (tareas, Cuaderno y sus archivos adjuntos, hábitos, archivo…): solo tú.
//  - profiles/{uid}       Perfil público (nombre, personaje, racha…): una cuenta verificada puede leer el de alguien
//                         concreto (un contacto, un compañero); nadie puede listarlos todos. Solo lo escribe su dueño.
//                         (level, title y xp siguen permitidos solo para que las versiones anteriores no fallen al guardar.)
//  - codes/{código}       Código de amigo → cuenta. Se consulta uno concreto; no se pueden listar. Cada uno crea o borra el suyo.
//  - inbox/{uid}          Buzón: solicitudes, aceptaciones, ánimos, equipos, avisos de chat e invitaciones por enlace.
//                         El dueño lo lee y lo vacía; los demás solo pueden escribir SU propia entrada (la clave es su uid).
//  - spaces/{id}          Equipos: solo sus miembros. Los miembros solo los cambia el creador (cada uno puede salir),
//                         y quien tenga el enlace del equipo puede añadirse a sí mismo con la clave correcta.
//  - spaces/{id}/pages    Páginas del Cuaderno del equipo: solo sus miembros.
//  - spaces/{id}/files    Archivos adjuntos de esas páginas (ficha y trozos de menos de 1 MB): solo sus miembros.
//  - chats/{id}           Chats de dos y de equipo: solo sus miembros.
//  - chats/{id}/msgs      Mensajes: los escriben los miembros; cada uno edita o borra los suyos y solo su reacción.
//  - blocks/{yo_otro}     Bloqueos: solo los ve y los cambia quien bloquea. Quien está bloqueado no puede escribir en
//                         tu buzón (solicitudes, ánimos, avisos) ni mandarte mensajes en un chat de dos.
//  - reports/{id}         Denuncias: se crean desde la app y solo se leen desde la consola de Firebase (moderación).
//  - errors/, feedback/   Informes de errores (con permiso) y comentarios: sin nombre ni cuenta; solo la consola los lee.
// Límites de tamaño en lo que otros escriben en tu buzón y en tu perfil, para que nadie pueda llenarlo.
// Todo exige un correo verificado (las cuentas de Google ya vienen verificadas).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function team(sid) { return get(/databases/$(database)/documents/spaces/$(sid)).data; }
    function isMember(sid) { return signedIn() && request.auth.uid in team(sid).members; }

    match /users/{uid}/{document=**} {
      allow read, write: if isMe(uid);
    }

    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'code', 'buddy', 'avatar', 'photo', 'level', 'title', 'xp', 'streak', 'bestStreak', 'weekDone', 'weekFocus', 'week', 'status', 'updatedAt'])
        && request.resource.data.uid == uid
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 80))
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() < 100000));
      allow delete: if isMe(uid);
    }

    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid', 'at']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Solo cambia la entrada de quien escribe en cada apartado del buzón
    function onlyMine(after, before) {
      return after.keys().hasOnly(['requests', 'accepted', 'cheers', 'spaces', 'pings', 'links'])
        && after.get('requests', {}).diff(before.get('requests', {})).affectedKeys().hasOnly([request.auth.uid])
        && after.get('accepted', {}).diff(before.get('accepted', {})).affectedKeys().hasOnly([request.auth.uid])
        && after.get('cheers', {}).diff(before.get('cheers', {})).affectedKeys().hasOnly([request.auth.uid])
        && after.get('spaces', {}).diff(before.get('spaces', {})).affectedKeys().hasOnly([request.auth.uid])
        && after.get('pings', {}).diff(before.get('pings', {})).affectedKeys().hasOnly([request.auth.uid])
        && after.get('links', {}).diff(before.get('links', {})).affectedKeys().hasOnly([request.auth.uid]);
    }
    // Lo que alguien deja en un buzón ajeno: un objeto pequeño (sin textos largos)
    function okEntry(e) {
      return e == null || (e is map && e.size() <= 20
        && e.get('name', '').size() <= 80 && e.get('text', '').size() <= 300 && e.get('from', '').size() <= 80);
    }
    function entriesOk(after) {
      return okEntry(after.get('requests', {}).get(request.auth.uid, null))
        && okEntry(after.get('accepted', {}).get(request.auth.uid, null))
        && okEntry(after.get('cheers', {}).get(request.auth.uid, null))
        && okEntry(after.get('spaces', {}).get(request.auth.uid, null))
        && okEntry(after.get('pings', {}).get(request.auth.uid, null))
        && okEntry(after.get('links', {}).get(request.auth.uid, null));
    }
    // ¿Me ha bloqueado esta persona?
    function blockedBy(owner) { return exists(/databases/$(database)/documents/blocks/$(owner + '_' + request.auth.uid)); }
    match /inbox/{uid} {
      allow read, write: if isMe(uid);
      allow create: if signedIn() && request.auth.uid != uid && !blockedBy(uid) && onlyMine(request.resource.data, {}) && entriesOk(request.resource.data);
      allow update: if signedIn() && request.auth.uid != uid && !blockedBy(uid) && onlyMine(request.resource.data, resource.data) && entriesOk(request.resource.data);
    }

    // Bloqueos: el id es «quien bloquea_bloqueado»; solo los ve y los cambia quien bloquea
    match /blocks/{id} {
      allow get, delete: if signedIn() && resource.data.by == request.auth.uid;
      allow list: if signedIn() && resource.data.by == request.auth.uid;
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['by', 'who', 'at'])
        && request.resource.data.who is string && request.resource.data.who != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.who;
    }

    // Informes de errores (solo con permiso, Ajustes → Privacidad) y comentarios (Ajustes → Ayuda): sin nombre ni
    // cuenta, se crean desde la app (con una cuenta verificada, para frenar el spam) y solo se leen en la consola
    match /errors/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['msg', 'stack', 'where', 'v', 'p', 'at'])
        && request.resource.data.msg is string && request.resource.data.msg.size() > 0 && request.resource.data.msg.size() <= 300
        && request.resource.data.get('stack', '').size() <= 1500
        && request.resource.data.get('where', '').size() <= 160
        && request.resource.data.get('v', '').size() <= 40
        && request.resource.data.get('p', '').size() <= 120
        && request.resource.data.at is number;
      allow read, update, delete: if false;
    }
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['kind', 'text', 'v', 'p', 'errors', 'at'])
        && request.resource.data.kind in ['idea', 'fallo', 'otro']
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.get('v', '').size() <= 40
        && request.resource.data.get('p', '').size() <= 120
        && request.resource.data.get('errors', '').size() <= 2000
        && request.resource.data.at is number;
      allow read, update, delete: if false;
    }

    // Denuncias: se crean desde la app y solo se leen en la consola de Firebase
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['by', 'who', 'reason', 'where', 'excerpt', 'at'])
        && request.resource.data.who is string && request.resource.data.who.size() <= 128
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 40
        && request.resource.data.get('where', '').size() <= 160
        && request.resource.data.get('excerpt', '').size() <= 600;
      allow read, update, delete: if false;
    }

    match /spaces/{sid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid && request.auth.uid in request.resource.data.members;
      // Miembros: tareas, páginas… El creador cambia los miembros y la clave del enlace; los demás solo pueden salir.
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.owner == resource.data.owner
        && (request.auth.uid == resource.data.owner
            || (request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
                && request.resource.data.get('joinKey', '') == resource.data.get('joinKey', '')));
      // Entrar con el enlace del equipo: solo te añades a ti, con la clave que lleva el enlace
      allow update: if signedIn() && !(request.auth.uid in resource.data.members)
        && resource.data.get('joinKey', '') != ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joins'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get('joins', {}).diff(resource.data.get('joins', {})).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.joins[request.auth.uid] == resource.data.joinKey;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /pages/{pid} {
        allow read, write: if isMember(sid);
      }
      // Archivos adjuntos de las páginas del equipo: la ficha y sus trozos
      match /files/{rest=**} {
        allow read, write: if isMember(sid);
      }
    }

    match /chats/{cid} {
      function isDm(d) {
        return d.type == 'dm' && d.memberIds.size() == 2 && d.memberIds[0] < d.memberIds[1]
          && cid == 'dm_' + d.memberIds[0] + '_' + d.memberIds[1];
      }
      function isTeamChat(d) {
        return d.type == 'team' && cid == 'tm_' + d.sid && d.memberIds.toSet() == team(d.sid).members.keys().toSet();
      }
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds
        && (isDm(request.resource.data) || isTeamChat(request.resource.data));
      allow update: if signedIn() && request.auth.uid in resource.data.memberIds
        && request.resource.data.type == resource.data.type
        && (request.resource.data.memberIds == resource.data.memberIds
            || (resource.data.type == 'team' && request.resource.data.sid == resource.data.sid && isTeamChat(request.resource.data)));

      match /msgs/{mid} {
        function chat() { return get(/databases/$(database)/documents/chats/$(cid)).data; }
        allow read: if signedIn() && request.auth.uid in chat().memberIds;
        // En un chat de dos, si la otra persona te ha bloqueado, no puedes escribirle
        function otherOf(ids) { return ids[0] == request.auth.uid ? ids[1] : ids[0]; }
        allow create: if signedIn() && request.auth.uid in chat().memberIds
          && !(chat().type == 'dm' && blockedBy(otherOf(chat().memberIds)))
          && request.resource.data.by == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 4000;
        // El autor edita o borra lo suyo; cualquiera de los miembros solo cambia su reacción
        allow update: if signedIn() && request.auth.uid in chat().memberIds
          && request.resource.data.by == resource.data.by
          && ((request.auth.uid == resource.data.by && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'del', 'ref', 'react']))
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['react']))
          && request.resource.data.get('react', {}).diff(resource.data.get('react', {})).affectedKeys().hasOnly([request.auth.uid]);
      }
    }

    // Todo lo demás está cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
