{
  "name": "whider",
  "version": "2.0.0",
  "private": true,
  "description": "WHIDER: tareas, calendario, Cuaderno, hábitos y enfoque para ordenador, móvil y web.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "python3 serve.py 8080",
    "build:web": "node tools/web-build.js",
    "serve:web": "python3 -I tools/servir-web.py . 8650",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "version:sync": "node tools/version.js",
    "version:check": "node tools/version.js --check",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run version:check && npm run i18n:check && npm run test:unit",
    "i18n:check": "node tools/i18n.js faltan --estricto",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "node tests/run.mjs app web",
    "test:nube": "node tests/run.mjs nube",
    "test:escritorio": "node tests/run.mjs escritorio",
    "test:todo": "node tests/run.mjs app nube web escritorio"
  },
  "dependencies": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "axe-core": "4.14.1",
    "eslint": "10.15.0",
    "firebase-tools": "14.27.0",
    "globals": "17.14.0",
    "playwright": "1.63.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3"
  }
}
